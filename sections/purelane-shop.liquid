
<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <article class="glass card rv">
          <div class="shot">
            {% if product.tags contains 'Best seller' or product.tags contains 'Top rated' or product.tags contains 'New' %}
              <span class="pill">
                {% if product.tags contains 'Best seller' %}Best seller
                {% elsif product.tags contains 'Top rated' %}Top rated
                {% elsif product.tags contains 'New' %}New
                {% endif %}
              </span>
            {% endif %}
            {% if product.featured_media %}
              <img src="{{ product.featured_media | image_url: width: 500 }}" class="pimg" alt="{{ product.featured_media.alt | escape }}" style="width:100%;height:100%;object-fit:cover;mix-blend-mode:multiply">
            {% else %}
              <div class="pimg" style="background:rgba(75,58,143,0.1);display:flex;align-items:center;justify-content:center;width:100%;height:100%;border-radius:12px">No image</div>
            {% endif %}
          </div>
          <h4 style="min-height:36px">{{ product.title | escape }}</h4>
          <div class="rate"><b>★ 4.8</b> &middot; 237 reviews</div>
          <div class="pr">
            <strong>{{ product.price | money_without_trailing_zeros }}</strong>
            {% if product.compare_at_price > product.price %}
              <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
              <em>{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% off</em>
            {% endif %}
          </div>
          {% if product.available %}
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
              <button class="btn btn-ghost btn-sm" type="submit" style="width:100%;margin-top:12px">Add to cart</button>
            </form>
          {% else %}
            <button class="btn btn-ghost btn-sm" disabled style="width:100%;margin-top:12px;opacity:0.5">Sold out</button>
          {% endif %}
        </article>
      {%- else -%}
        <!-- Fallback if no collection selected -->
        {% for i in (1..4) %}
        <article class="glass card rv">
          <div class="shot"><div class="pimg" style="background:rgba(75,58,143,0.1);width:100%;height:100%;border-radius:12px"></div></div>
          <h4>Example Product {{ i }}</h4>
          <div class="rate"><b>★ 5.0</b> &middot; 100 reviews</div>
          <div class="pr"><strong>Rs. 200</strong></div>
          <button class="btn btn-ghost btn-sm" style="width:100%;margin-top:12px">Add to cart</button>
        </article>
        {% endfor %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
