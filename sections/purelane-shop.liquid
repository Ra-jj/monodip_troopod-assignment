
<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule">
        <i></i>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {%- render 'purelane-product-card', product: product -%}
      {%- else -%}
        <!-- Fallback if no collection selected matches original exactly -->
        <article class="glass card rv"><div class="shot"><span class="pill">Best seller</span><span class="pimg p-kbtl" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span></div><h4>Foaming Kitchen Cleaner &amp; Degreaser</h4><div class="rate"><b>&#9733; 4.8</b> &middot; 237 reviews</div><div class="pr"><strong>&#8377;200</strong><s>&#8377;299</s><em>33% off</em></div><button class="btn btn-ghost btn-sm" style="width:100%;margin-top:12px">Add to cart</button></article>
        <article class="glass card rv"><div class="shot"><span class="pill">New</span><span class="pimg p-tbtl" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span></div><h4 style="min-height:36px">Tap Cleaner &amp; Limescale Remover</h4><div class="rate"><b>&#9733; 4.6</b> &middot; 104 reviews</div><div class="pr"><strong>&#8377;249</strong><s>&#8377;349</s><em>29% off</em></div><button class="btn btn-ghost btn-sm" style="width:100%;margin-top:12px">Add to cart</button></article>
        <article class="glass card rv"><div class="shot"><span class="pimg p-lbtl" role="img" aria-label="Purelane non-toxic laundry detergent liquid bottle"></span></div><h4 style="min-height:36px">Non-toxic Laundry Detergent</h4><div class="rate"><b>&#9733; 4.9</b> &middot; 412 reviews</div><div class="pr"><strong>&#8377;349</strong><s>&#8377;499</s><em>30% off</em></div><button class="btn btn-ghost btn-sm" style="width:100%;margin-top:12px">Add to cart</button></article>
        <article class="glass card rv"><div class="shot"><span class="pill">Top rated</span><span class="pimg p-fbtl" role="img" aria-label="Purelane natural herbal floor cleaner liquid bottle"></span></div><h4 style="min-height:36px">Natural Herbal Floor Cleaner</h4><div class="rate"><b>&#9733; 4.8</b> &middot; 189 reviews</div><div class="pr"><strong>&#8377;199</strong><s>&#8377;249</s><em>20% off</em></div><button class="btn btn-ghost btn-sm" style="width:100%;margin-top:12px">Add to cart</button></article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
