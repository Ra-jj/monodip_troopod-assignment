<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule"><i></i><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.description | escape }}</p>
    </div>
    
    <div class="comborail rv">
      {%- for block in section.blocks -%}
        {%- assign p1 = all_products[block.settings.product_1] -%}
        {%- assign p2 = all_products[block.settings.product_2] -%}
        {%- assign p3 = all_products[block.settings.product_3] -%}
        
        {%- assign total_value = 0 -%}
        {%- assign product_count = 0 -%}
        
        {%- if p1 != blank -%}
          {%- assign p1_val = p1.compare_at_price | default: p1.price -%}
          {%- assign total_value = total_value | plus: p1_val -%}
          {%- assign product_count = product_count | plus: 1 -%}
        {%- endif -%}
        {%- if p2 != blank -%}
          {%- assign p2_val = p2.compare_at_price | default: p2.price -%}
          {%- assign total_value = total_value | plus: p2_val -%}
          {%- assign product_count = product_count | plus: 1 -%}
        {%- endif -%}
        {%- if p3 != blank -%}
          {%- assign p3_val = p3.compare_at_price | default: p3.price -%}
          {%- assign total_value = total_value | plus: p3_val -%}
          {%- assign product_count = product_count | plus: 1 -%}
        {%- endif -%}
        
        {%- assign bundle_price = block.settings.bundle_price | times: 100 -%}
        {%- if bundle_price == 0 or bundle_price == blank -%}
          {%- assign bundle_price = total_value -%}
        {%- endif -%}
        
        {%- assign savings = total_value | minus: bundle_price -%}
        
        <article class="glass combo {% if block.settings.is_hero %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
          <div class="tray">
            {%- if savings > 0 -%}
              <span class="save">You save &#8377;{{ savings | money_without_currency | remove: '.00' }}</span>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="flag">{{ block.settings.badge | escape }}</span>
            {%- endif -%}
            
            <div class="stack">
              {%- if p1 != blank -%}
                <span class="it">
                  {%- if p1.featured_image -%}
                    <img src="{{ p1.featured_image | image_url: width: 100 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p1.title | escape }}" loading="lazy">
                  {%- else -%}
                    <span class="pimg" role="img" aria-label="{{ p1.title | escape }}"></span>
                  {%- endif -%}
                  <span>{{ block.settings.p1_note | escape }}</span>
                </span>
              {%- else -%}
                <span class="it"><span class="pimg {% if forloop.index == 1 %}p-kitchen{% elsif forloop.index == 2 %}p-laundry{% elsif forloop.index == 3 %}p-kitchen{% endif %}" role="img"></span><span>{% if forloop.index == 1 %}Cuts grease instantly{% elsif forloop.index == 2 %}Removes tough stains & odour{% elsif forloop.index == 3 %}Cuts grease instantly{% endif %}</span></span>
              {%- endif -%}
              
              <span class="plus" aria-hidden="true">+</span>
              
              {%- if p2 != blank -%}
                <span class="it">
                  {%- if p2.featured_image -%}
                    <img src="{{ p2.featured_image | image_url: width: 100 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p2.title | escape }}" loading="lazy">
                  {%- else -%}
                    <span class="pimg" role="img" aria-label="{{ p2.title | escape }}"></span>
                  {%- endif -%}
                  <span>{{ block.settings.p2_note | escape }}</span>
                </span>
              {%- else -%}
                <span class="it"><span class="{% if forloop.index == 2 %}tile{% else %}pimg {% if forloop.index == 1 %}p-dish{% elsif forloop.index == 3 %}p-floor{% endif %}{% endif %}" role="img">
                  {% if forloop.index == 2 %}<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>{% endif %}
                </span><span>{% if forloop.index == 1 %}Squeaky clean dishes{% elsif forloop.index == 2 %}Softens & freshens every wash{% elsif forloop.index == 3 %}Kills 99.9% germs{% endif %}</span></span>
              {%- endif -%}
              
              <span class="plus" aria-hidden="true">+</span>
              
              {%- if p3 != blank -%}
                <span class="it">
                  {%- if p3.featured_image -%}
                    <img src="{{ p3.featured_image | image_url: width: 100 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p3.title | escape }}" loading="lazy">
                  {%- else -%}
                    <span class="pimg" role="img" aria-label="{{ p3.title | escape }}"></span>
                  {%- endif -%}
                  <span>{{ block.settings.p3_note | escape }}</span>
                </span>
              {%- else -%}
                <span class="it"><span class="pimg {% if forloop.index == 1 %}p-tap{% elsif forloop.index == 2 %}p-wm{% elsif forloop.index == 3 %}p-handwash{% endif %}" role="img"></span><span>{% if forloop.index == 1 %}Melts hard water stains{% elsif forloop.index == 2 %}Deep-cleans your machine{% elsif forloop.index == 3 %}Gentle hydration for hands{% endif %}</span></span>
              {%- endif -%}
            </div>
          </div>
          <div class="body">
            <h3>{{ block.settings.title | escape }}</h3>
            <div class="cnt">{{ product_count }} products</div>
            <p class="inc">{{ block.settings.description | escape }}</p>
            <div class="prow">
              <strong>&#8377;{{ bundle_price | money_without_currency | remove: '.00' }}</strong>
              {%- if savings > 0 -%}
                <s>&#8377;{{ total_value | money_without_currency | remove: '.00' }}</s>
                <em>Save &#8377;{{ savings | money_without_currency | remove: '.00' }}</em>
              {%- endif -%}
            </div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="#bundles">
              Shop bundle <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="swipecue" aria-hidden="true"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos</div>
    <p class="railnote">Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combo Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (Optional)"
        },
        {
          "type": "checkbox",
          "id": "is_hero",
          "label": "Make this the featured/hero combo",
          "default": false
        },
        {
          "type": "number",
          "id": "bundle_price",
          "label": "Custom Bundle Price (leave blank to sum products)"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "p1_note",
          "label": "Product 1 Note"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "p2_note",
          "label": "Product 2 Note"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "p3_note",
          "label": "Product 3 Note"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos"
    }
  ]
}
{% endschema %}
