<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.description | escape }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier {% if block.settings.is_popular %}best{% endif %} rv rv-d{{ forloop.index | plus: 1 }}" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.badge | escape }}</span>
          
          <div class="tierpix {% if block.settings.product_4 != blank %}five{% endif %}" aria-hidden="true">
            {%- assign p1 = all_products[block.settings.product_1] -%}
            {%- assign p2 = all_products[block.settings.product_2] -%}
            {%- assign p3 = all_products[block.settings.product_3] -%}
            {%- assign p4 = all_products[block.settings.product_4] -%}
            {%- assign p5 = all_products[block.settings.product_5] -%}
            
            {%- if p1 != blank -%}{%- if p1.featured_image -%}<img src="{{ p1.featured_image | image_url: width: 80 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p1.title | escape }}" loading="lazy">{%- else -%}<span class="pimg" role="img" aria-label="{{ p1.title | escape }}"></span>{%- endif -%}{%- endif -%}
            {%- if p2 != blank -%}{%- if p2.featured_image -%}<img src="{{ p2.featured_image | image_url: width: 80 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p2.title | escape }}" loading="lazy">{%- else -%}<span class="pimg" role="img" aria-label="{{ p2.title | escape }}"></span>{%- endif -%}{%- endif -%}
            {%- if p3 != blank -%}{%- if p3.featured_image -%}<img src="{{ p3.featured_image | image_url: width: 80 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p3.title | escape }}" loading="lazy">{%- else -%}<span class="pimg" role="img" aria-label="{{ p3.title | escape }}"></span>{%- endif -%}{%- endif -%}
            {%- if p4 != blank -%}{%- if p4.featured_image -%}<img src="{{ p4.featured_image | image_url: width: 80 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p4.title | escape }}" loading="lazy">{%- else -%}<span class="pimg" role="img" aria-label="{{ p4.title | escape }}"></span>{%- endif -%}{%- endif -%}
            {%- if p5 != blank -%}{%- if p5.featured_image -%}<img src="{{ p5.featured_image | image_url: width: 80 }}" class="pimg" style="object-fit: contain; mix-blend-mode: multiply;" alt="{{ p5.title | escape }}" loading="lazy">{%- else -%}<span class="pimg" role="img" aria-label="{{ p5.title | escape }}"></span>{%- endif -%}{%- endif -%}
            
            {%- if p1 == blank -%}
              {%- if forloop.index == 1 -%}<span class="pimg p-combo2" role="img"></span>{%- endif -%}
              {%- if forloop.index == 2 -%}<span class="pimg p-kitchen" role="img"></span><span class="pimg p-tap" role="img"></span><span class="pimg p-dish" role="img"></span>{%- endif -%}
              {%- if forloop.index == 3 -%}<span class="pimg p-kitchen" role="img"></span><span class="pimg p-tap" role="img"></span><span class="pimg p-floor" role="img"></span><span class="pimg p-toilet" role="img"></span><span class="pimg p-laundry" role="img"></span>{%- endif -%}
            {%- endif -%}
          </div>
          
          <div class="qty">{{ block.settings.qty }}<small>Products</small></div>
          <div class="price">{{ block.settings.price | times: 100 | money_without_trailing_zeros }} <s>{{ block.settings.compare_price | times: 100 | money_without_trailing_zeros }}</s></div>
          <p class="body-s" style="font-size:12px">{{ block.settings.subtext | escape }}</p>
          
          <ul>
            {%- if block.settings.bullet_1 != blank -%}
              <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_1 | escape }}</li>
            {%- endif -%}
            {%- if block.settings.bullet_2 != blank -%}
              <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_2 | escape }}</li>
            {%- endif -%}
            {%- if block.settings.bullet_3 != blank -%}
              <li><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_3 | escape }}</li>
            {%- endif -%}
          </ul>
          
          <a class="btn {% if block.settings.is_popular %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.link }}">
            {{ block.settings.btn_text | escape }}
            {%- if block.settings.is_popular -%}
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text"
        },
        {
          "type": "checkbox",
          "id": "is_popular",
          "label": "Highlight as popular",
          "default": false
        },
        {
          "type": "number",
          "id": "qty",
          "label": "Quantity of Products"
        },
        {
          "type": "number",
          "id": "price",
          "label": "Price (Number)"
        },
        {
          "type": "number",
          "id": "compare_price",
          "label": "Compare at price (Number)"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "text",
          "id": "bullet_1",
          "label": "Bullet 1"
        },
        {
          "type": "text",
          "id": "bullet_2",
          "label": "Bullet 2"
        },
        {
          "type": "text",
          "id": "bullet_3",
          "label": "Bullet 3"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Graphic Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Graphic Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Graphic Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Graphic Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Graphic Product 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles"
    }
  ]
}
{% endschema %}
