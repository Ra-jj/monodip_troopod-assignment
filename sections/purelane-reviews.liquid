
<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>4.8</b> from 8,000+ reviews</span>
      <span class="agg">Loved by <b>12 lakh+</b> homes</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" {{ block.shopify_attributes }}>
          <div class="st">
            {%- for i in (1..block.settings.stars) -%}&#9733;{%- endfor -%}
          </div>
          <h5>{{ block.settings.title | escape }}</h5>
          <p>{{ block.settings.text | escape }}</p>
          <div class="who">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author | escape }}</b>
            {%- if block.settings.product_name != blank -%}
              <span>&middot; {{ block.settings.product_name | escape }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        <!-- Fallback if no blocks added -->
        <article class="glass-2 rcard"><div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div><h5>Example review</h5><p>Add reviews in the theme editor.</p><div class="who"><b>Customer</b></div></article>
      {%- endfor -%}
      <!-- Duplicate the reviews for the marquee effect -->
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">
            {%- for i in (1..block.settings.stars) -%}&#9733;{%- endfor -%}
          </div>
          <h5>{{ block.settings.title | escape }}</h5>
          <p>{{ block.settings.text | escape }}</p>
          <div class="who">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author | escape }}</b>
            {%- if block.settings.product_name != blank -%}
              <span>&middot; {{ block.settings.product_name | escape }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
